config flow 'flow'
	option enabled '1'
	option transparent '0'
	option handle_redirect '1'
	option listen_addr '0.0.0.0'
	option proxy_port '8080'
	option transparent_http_port '3128'
	option transparent_https_port '8443'
	option cooldown_seconds '15'
	option ca_cert '/etc/flow-local/ca.crt'
	option ca_key '/etc/flow-local/ca.key'
	option status_file '/tmp/flow-local/status.json'
	option verbose '0'
