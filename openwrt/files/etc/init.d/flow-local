#!/bin/sh /etc/rc.common
# flow-local — Flow local test proxy (MITM patch + redirect handling)

START=90
STOP=10
USE_PROCD=1

PROG=/usr/bin/flow-local
CA_DIR=/etc/flow-local

start_service() {
    [ -x "$PROG" ] || {
        logger -t flow-local "binary not found: $PROG"
        return 1
    }

    # Generate a unique CA on first run so clients can trust this router.
    if [ ! -s "$CA_DIR/ca.crt" ] || [ ! -s "$CA_DIR/ca.key" ]; then
        if ! "$PROG" -gen-ca "$CA_DIR"; then
            logger -t flow-local "failed to generate CA"
            return 1
        fi
        logger -t flow-local "generated CA in $CA_DIR"
    fi

    procd_open_instance
    procd_set_param command "$PROG"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    # The binary re-reads UCI config on SIGHUP.
    killall -HUP flow-local 2>/dev/null || true
}
